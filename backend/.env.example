# Network listeners. backend/.env is the single source of truth for both
# FastAPI and the Vite development server. Change ports here; do not edit code.
MRLC_HOST=127.0.0.1
MRLC_PORT=8080
MRLC_DEV_HOST=0.0.0.0
MRLC_DEV_PORT=5173
# Optional comma-separated hostnames accepted by Vite when accessed through a reverse proxy.
# Hostnames from MRLC_ALLOWED_ORIGINS are also added automatically.
# MRLC_DEV_ALLOWED_HOSTS=mrlc.example.com

# Required: choose random long credentials; do NOT store secrets in VITE_* variables.
# MRLC_ADMIN_PASSWORD is the administrator credential and stays authoritative in
# the environment: it is verified on every login and is never written to SQLite.
# Change it here and restart to rotate the administrator password.
MRLC_ADMIN_PASSWORD=change-me-to-a-long-random-password
# Independent URL-login credential for the configured administrator. Do not reuse
# MRLC_ADMIN_PASSWORD. Use a random URL-safe value of at least 24 characters.
MRLC_ADMIN_TOKEN=change-me-to-an-independent-random-login-token
MRLC_SESSION_SECRET=change-me-to-an-independent-long-random-secret
# Optional: username of the environment-configured administrator (default: owner).
# MRLC_ADMIN_USERNAME=owner

# Persistent database and artifacts (paths relative to backend/ working directory)
MRLC_DB_PATH=./var/mrlc.sqlite3
MRLC_ARTIFACT_DIR=./var/artifacts
# Managed backup root. Infra Recovery creates immutable backup directories here and
# performs restore drills into isolated staging directories; it never overwrites the live DB.
MRLC_BACKUP_DIR=./var/backups

# Optional service-to-service token
# MRLC_SERVICE_TOKEN=...

# Optional real inference; use an explicitly authorized OpenAI-compatible endpoint.
# MRLC_MODEL_BASE_URL=http://127.0.0.1:3456/v1
# MRLC_MODEL_ID=your-model-id
# MRLC_MODEL_API_KEY=...

# Browser mutation origins accepted by the backend. Comma-separated values let
# localhost, LAN access and a reverse-proxy hostname coexist. Vite also derives
# server.allowedHosts from these URLs. Use the exact browser scheme/host/port.
MRLC_ALLOWED_ORIGINS=http://localhost:${MRLC_DEV_PORT}
# Example:
# MRLC_ALLOWED_ORIGINS=http://localhost:${MRLC_DEV_PORT},http://192.168.50.2:${MRLC_DEV_PORT},https://mrlc.example.com
# Legacy single-value MRLC_ALLOWED_ORIGIN is still accepted.
# MRLC_MAX_CONCURRENT_JOBS=2
# Maximum approximate durable-Memory tokens injected into each model call (0 disables it).
MRLC_MEMORY_CONTEXT_TOKEN_BUDGET=1200

# Optional Frontier CONSULT through an authorized CCR endpoint. Without CCR_API_KEY,
# the UI reports CONSULT unavailable and never fabricates advice.
# MRLC_CCR_BASE_URL=http://127.0.0.1:3456
# CCR_API_KEY=...
# MRLC_FRONTIER_MODEL_BINDING=router-managed
# MRLC_FRONTIER_BUDGET=1000
# DELEGATE is intentionally still unavailable through the FastAPI product surface.
# MRLC_FRONTIER_ALLOW_DELEGATION=false
# MRLC_STATIC_DIR=../dist  # Serve built frontend from this API process in production

# Optional provider accounting. Leave zero when unknown; MRLC will not invent costs.
MRLC_MODEL_INPUT_USD_PER_1M=0
MRLC_MODEL_OUTPUT_USD_PER_1M=0
