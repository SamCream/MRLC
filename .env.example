# Frontend-only public configuration.
# The Vite development /api proxy derives its backend host/port from
# backend/.env (MRLC_HOST + MRLC_PORT), so do not duplicate the backend port here.
VITE_DATA_SOURCE=http
VITE_API_BASE_URL=/
VITE_EVENTS_URL=/api/v1/events

# Dev listener host/port live in backend/.env as MRLC_DEV_HOST/MRLC_DEV_PORT.
# Optional override when the Vite dev server must talk to a backend elsewhere.
# VITE_BACKEND_URL=http://192.168.1.10:9000

# Explicit offline UI demonstration (not a backend): VITE_DATA_SOURCE=mock
# NEVER put model credentials or administrator passwords in VITE_* config.
